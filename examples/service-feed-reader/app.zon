.{
    .id = "dev.native_sdk.service_feed_reader",
    .name = "service-feed-reader",
    .display_name = "Service Feed Reader",
    .description = "The complete services loop: Cmd.fetch downloads a feed, a TypeScript service parses it into typed records through the generated client, and the markup renders them.",
    .version = "0.1.0",
    .platforms = .{"macos"},
    // The network permission covers the one effect that leaves the
    // process: the buffered `Cmd.fetch` exchange with the feed URL.
    .permissions = .{ "view", "network" },
    .capabilities = .{ "native_views", "gpu_surfaces" },
    .shell = .{
        .windows = .{.{
            .label = "main",
            .title = "Service Feed Reader",
            .width = 640,
            .height = 480,
            .min_width = 460,
            .min_height = 320,
            .restore_state = false,
            .restore_policy = "center_on_primary",
            .views = .{.{
                .label = "feed-canvas",
                .kind = "gpu_surface",
                .fill = true,
                .role = "Feed reader",
                .accessibility_label = "TypeScript service feed reader",
                .gpu_backend = "metal",
                .gpu_pixel_format = "bgra8_unorm",
                .gpu_present_mode = "timer",
                .gpu_alpha_mode = "opaque",
                .gpu_color_space = "srgb",
                .gpu_vsync = true,
            }},
        }},
    },
}
