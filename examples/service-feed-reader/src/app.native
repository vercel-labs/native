<column padding="24" gap="16" background="background">
  <column gap="6">
    <text size="heading">Service Feed Reader</text>
    <text wrap="true" foreground="text_muted">Cmd.fetch downloads the feed. The feeds.parse service turns the raw bytes into typed records, and this view renders them.</text>
  </column>
  <panel padding="18" background="surface" radius="lg" grow="1">
    <column gap="10">
      <row gap="8" cross="center">
        <text size="sm" foreground="text_muted" wrap="false">{url}</text>
        <spacer grow="1" />
        <if test="{loading}">
          <badge variant="secondary">Working</badge>
        </if>
      </row>
      <if test="{failed}">
        <column gap="4">
          <text foreground="destructive">The request failed.</text>
          <text size="sm" foreground="text_muted" wrap="true">{reason}</text>
        </column>
      </if>
      <if test="{ready}">
        <column gap="10" grow="1">
          <text size="lg">{feedTitle}</text>
          <scroll grow="1" label="Feed items">
            <column gap="8">
              <for each="items" as="item">
                <column gap="2">
                  <text wrap="true">{item.title}</text>
                  <text size="sm" foreground="text_muted" wrap="false">{item.link}</text>
                </column>
              </for>
            </column>
          </scroll>
        </column>
      </if>
    </column>
  </panel>
  <row gap="8" cross="center">
    <button variant="primary" on-press="refresh">Fetch feed</button>
    <button variant="outline" on-press="load_sample">Parse the sample</button>
    <spacer grow="1" />
    <text size="sm" foreground="text_muted">{itemSummary}</text>
  </row>
</column>
