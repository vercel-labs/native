<import src="components/editor.native" />
<use template="editor"
  titlebarheight="{page1.titlebar_height}"
  chromeleading="{page1.chrome_leading}"
  rootname="{page1.rootName}"
  savedisabled="{page1.saveDisabled}"
  folderopen="{page1.folderOpen}"
  sidebarfraction="{page1.sidebar_fraction}"
  visible="{page1.visible}"
  renametext="{page1.renameText}"
  selectedisfile="{page1.selectedIsFile}"
  opentabs="{page1.openTabs}"
  previewstate="{page1.previewState}"
  previewlanguage="{page1.previewLanguage}"
  preview="{page1.preview}"
  codeeditable="{page1.codeEditable}"
  selectedpath="{page1.selectedPath}"
  emptyeditortitle="{page1.emptyEditorTitle}"
  emptyeditordetail="{page1.emptyEditorDetail}"
  status="{page1.status}"
/>
