<import src="components/editor.native" />
<use template="editor"
  titlebarheight="{page4.titlebar_height}"
  chromeleading="{page4.chrome_leading}"
  rootname="{page4.rootName}"
  savedisabled="{page4.saveDisabled}"
  folderopen="{page4.folderOpen}"
  sidebarfraction="{page4.sidebar_fraction}"
  visible="{page4.visible}"
  renametext="{page4.renameText}"
  selectedisfile="{page4.selectedIsFile}"
  opentabs="{page4.openTabs}"
  previewstate="{page4.previewState}"
  previewlanguage="{page4.previewLanguage}"
  preview="{page4.preview}"
  codeeditable="{page4.codeEditable}"
  selectedpath="{page4.selectedPath}"
  emptyeditortitle="{page4.emptyEditorTitle}"
  emptyeditordetail="{page4.emptyEditorDetail}"
  status="{page4.status}"
/>
