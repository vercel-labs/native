<import src="components/editor.native" />
<use template="editor"
  titlebarheight="{page3.titlebar_height}"
  chromeleading="{page3.chrome_leading}"
  rootname="{page3.rootName}"
  savedisabled="{page3.saveDisabled}"
  folderopen="{page3.folderOpen}"
  sidebarfraction="{page3.sidebar_fraction}"
  visible="{page3.visible}"
  renametext="{page3.renameText}"
  selectedisfile="{page3.selectedIsFile}"
  opentabs="{page3.openTabs}"
  previewstate="{page3.previewState}"
  previewlanguage="{page3.previewLanguage}"
  preview="{page3.preview}"
  codeeditable="{page3.codeEditable}"
  selectedpath="{page3.selectedPath}"
  emptyeditortitle="{page3.emptyEditorTitle}"
  emptyeditordetail="{page3.emptyEditorDetail}"
  status="{page3.status}"
/>
