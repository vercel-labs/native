<import src="components/editor.native" />
<use template="editor"
  titlebarheight="{page2.titlebar_height}"
  chromeleading="{page2.chrome_leading}"
  rootname="{page2.rootName}"
  savedisabled="{page2.saveDisabled}"
  folderopen="{page2.folderOpen}"
  sidebarfraction="{page2.sidebar_fraction}"
  visible="{page2.visible}"
  renametext="{page2.renameText}"
  selectedisfile="{page2.selectedIsFile}"
  opentabs="{page2.openTabs}"
  previewstate="{page2.previewState}"
  previewlanguage="{page2.previewLanguage}"
  preview="{page2.preview}"
  codeeditable="{page2.codeEditable}"
  selectedpath="{page2.selectedPath}"
  emptyeditortitle="{page2.emptyEditorTitle}"
  emptyeditordetail="{page2.emptyEditorDetail}"
  status="{page2.status}"
/>
