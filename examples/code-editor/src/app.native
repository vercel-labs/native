<import src="windows/components/editor.native" />
<use template="editor"
  titlebarheight="{page0.titlebar_height}"
  chromeleading="{page0.chrome_leading}"
  rootname="{page0.rootName}"
  savedisabled="{page0.saveDisabled}"
  folderopen="{page0.folderOpen}"
  sidebarfraction="{page0.sidebar_fraction}"
  visible="{page0.visible}"
  renametext="{page0.renameText}"
  selectedisfile="{page0.selectedIsFile}"
  opentabs="{page0.openTabs}"
  previewstate="{page0.previewState}"
  previewlanguage="{page0.previewLanguage}"
  preview="{page0.preview}"
  codeeditable="{page0.codeEditable}"
  selectedpath="{page0.selectedPath}"
  emptyeditortitle="{page0.emptyEditorTitle}"
  emptyeditordetail="{page0.emptyEditorDetail}"
  status="{page0.status}"
/>
