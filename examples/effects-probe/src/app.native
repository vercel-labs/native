<column gap="8" padding="12" background="background">
  <row gap="8" cross="center">
    <button variant="primary" on-press="start" disabled="{streaming}">Start stream</button>
    <button variant="destructive" on-press="cancel" disabled="{idle}">Cancel</button>
    <button on-press="copy_status">{copyLabel}</button>
    <spacer grow="1" />
    <text foreground="text_muted">{statusText}</text>
  </row>
  <scroll grow="1" background="surface" radius="md">
    <column gap="2" padding="8">
      <for each="visible" as="l" key="line"><text>{l.line}</text></for>
    </column>
  </scroll>
  <status-bar>{totals}</status-bar>
</column>
