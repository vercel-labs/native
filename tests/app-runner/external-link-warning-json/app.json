{
  "id": "dev.native_sdk.external_link_warning_json",
  "name": "external-link-warning-json",
  "display_name": "External Link Warning JSON",
  "version": "0.1.0",
  "capabilities": ["native_views", "gpu_surfaces"],
  "shell": {
    "windows": [
      {
        "label": "main",
        "title": "External Link Warning JSON",
        "width": 320,
        "height": 200,
        "views": [
          { "label": "main-canvas", "kind": "gpu_surface", "fill": true }
        ]
      }
    ]
  },
  "security": {
    "navigation": {
      "external_links": {
        "action": "open_system_browser",
        "allowed_urls": [
          "https://example.com/docs/*",
          "https://*.example.com/*",
          "https://*/"
        ]
      }
    }
  }
}
