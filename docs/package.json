{
  "name": "@native-sdk/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "next dev",
    "build": "fumadocs-mdx && next build",
    "start": "next start",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "check": "node scripts/check-app-schema.mjs && pnpm typecheck && pnpm build && node scripts/check-doc-routes.mjs && node scripts/check-code-toggle.mjs && node scripts/check-wasm-preview.mjs",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "geist": "^1.7.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shiki": "^4.0.2",
    "@vercel/geistdocs": "2.7.8",
    "fumadocs-core": "16.2.2",
    "fumadocs-mdx": "14.0.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "@types/mdast": "^4",
    "unist-util-visit": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": ">=8.5.10"
    }
  }
}
