{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": ["NATIVE_*"],
  "globalPassThroughEnv": ["PATH", "HOME", "TMPDIR", "TEMP", "TMP", "USERPROFILE", "APPDATA", "LOCALAPPDATA", "SystemRoot", "LANG", "LC_ALL", "XDG_CACHE_HOME", "XDG_RUNTIME_DIR", "DISPLAY", "WAYLAND_DISPLAY", "CC", "CI"],
  "tasks": {
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "dependsOn": ["typecheck"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["typecheck"],
      "cache": false
    },
    "test:examples": {
      "cache": false
    },
    "wpt": {
      "cache": false,
      "outputs": ["wpt/results*.json"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
